@import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

:root {
    --card-height: 120px;
    
    /* Fontes */
    --font-family-serif: "Playfair Display", Georgia, serif;
    --font-family-sans-serif: "Lato", Helvetica, Arial, sans-serif;

    /* ===============================================================
       Paleta Semântica — Gaia Viva / Culinária Funcional
       Baseada nos cards institucionais @gaiaviva
       
       LÓGICA DE MAPEAMENTO
       --------------------
       As cores brutas da paleta original já exerciam papéis implícitos nos
       cards — este arquivo apenas torna esses papéis explícitos, seguindo
       a convenção semântica do Bootstrap (primary, secondary, etc.).
       
       PRIMARY → verde-floresta (#2D5435)
         Cor de maior peso identitário: ocupa fundos inteiros, não apenas
         detalhes. Usada para botões principais, links e elementos de marca.
         --color-primary-light (#4A8A5C) cobre hover e variantes acessíveis
         sobre fundos claros.
       
       SECONDARY → ferrugem (#C0582A)
         Nos cards originais, marca termos editorialmente importantes
         ("proteína", "fibra"). Esse papel — destacar sem ser o CTA principal
         — é exatamente o que o secondary resolve. --color-secondary-dark
         (#8B4A2B) cobre bordas e estados ativos.
       
       ACCENT → âmbar/ocre (#E8A030 / #C8A035)
         Diferente do Bootstrap, esta paleta justifica um terceiro papel
         semântico: o dourado aparece tanto como fundo de card quanto como
         texto de destaque, com tom informativo — ideal para badges e tags.
         Não confundir com "warning": aqui não há urgência, só ênfase.
       
       SUPERFÍCIES → areia e creme (#F0EBE0, #F5F0E8, #C47A45)
         Três níveis de elevação inspirados nos fundos dos próprios cards:
           surface          → fundo de página (neutro, mais frio)
           surface-raised   → cards e modais (mais quente, levemente elevado)
           surface-emphasis → hero sections e banners (terracota saturado)
       
       TEXTOS → verde-escuro e creme (#2D3B2D, #F5F0E8, #8B4A2B)
         O verde-escuro quase-preto (#2D3B2D) é o text padrão — mantém
         coerência cromática com o primary sem usar preto puro.
         O creme (#F5F0E8) é o text-inverse para fundos escuros/saturados.
         O castanho (#8B4A2B) assume o papel de text-muted: quente o
         suficiente para pertencer à paleta, discreto o suficiente para
         legendas e metadados.
   
       O QUE ESTÁ FORA DO ESCOPO
       --------------------------
       Cores de estado (success, danger, warning, info) não existem na
       paleta original. Se o projeto precisar de validação de
       formulários ou alertas, introduza essas cores separadamente,
       sem sobrescrever secondary ou accent com semânticas que não
       pertencem à marca.
       ============================================================ */

    /* primary */
    --color-primary:          #2D5435;
    --color-primary-light:    #4A8A5C;

    /* secondary */
    --color-secondary:        #C0582A;
    --color-secondary-dark:   #8B4A2B;

    /* accent */
    --color-accent:           #E8A030;
    --color-accent-dark:      #C8A035;

    /* superfícies */
    --color-surface:          #F0EBE0;
    --color-surface-raised:   #F5F0E8;
    --color-surface-emphasis: #C47A45;

    /* textos */
    --color-text:             #2D3B2D;
    --color-text-inverse:     #F5F0E8;
    --color-text-muted:       #8B4A2B;

    /* success — verde esmeralda (≠ primary verde-floresta) */
    --color-success: #1A6B3C;
    --color-success-bg: #D4EDDA;
    --color-success-text: #145C32;

    /* warning — laranja escuro (≠ accent âmbar dourado) */
    --color-warning: #B85C00;
    --color-warning-bg: #FFF3CD;
    --color-warning-text: #7A3D00;

    /* danger — vermelho carmim (≠ secondary ferrugem) */
    --color-danger: #C0392B;
    --color-danger-bg: #FDECEA;
    --color-danger-text: #922B21;

    /* info — azul petróleo (sem conflito na paleta) */
    --color-info: #1A6E8A;
    --color-info-bg: #D6EEF5;
    --color-info-text: #0E4D61;
}

/*
 * By default, padding and border are added outside the content box.
 * border-box changes this so the width you set includes padding and
 * border, preventing unexpected overflows.
 *
 * ref: https://w3bits.com/blog/box-sizing-reset/
 */
html {
    box-sizing: border-box;
}
*, *::before, *::after {
    box-sizing: inherit;
}


/* DEBUG */
/* * { outline: 1px solid red; }* { outline: 1px solid red; } */


/*********************************************************************
 * Configuração Geral 
 ********************************************************************/
html {
    background-color: var(--color-surface);
    color: var(--primary-color);
}

body {
    height: 100vh;
}

.container {
    padding: 5px;

    /* Centers the container horizontally */  
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
    align-self: center;

}

/* Prevent images to bleed outside the container */
.container img {
    width: 100%;    /* Fills the container width */
    height: auto;   /* Maintains aspect ratio */
}

/*
 * Tipografia
 */
h1, h2, h3 {
    font-family: var(--font-family-serif);
    font-optical-sizing: auto;
    font-weight: 700;
    font-style: normal;
    color: var(--color-text);
}

p {
    font-family: var(--font-family-sans-serif);
    font-weight: 400;
    font-style: normal;
    color: var(--color-text);
}

/*********************************************************************
 * Cabeçalho 
 ********************************************************************/
.header {
    text-align: center;    
}

.title {
    font-size: 2.8rem;
    margin-top: -40px;
    margin-bottom: 0;
}

.description p {
    margin: 0 0;
    font-size: 1.3rem;
    font-style: italic;
    color: var(--color-danger);
}

.divider {
    border: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(74, 138, 92, 0.5), transparent);
    margin: 24px auto;
    width: 80%;
}

.avatar {
    width: 100%;
    mask-image: linear-gradient(to top, transparent 0%, black 45%);
    z-index: 1;
    margin: 0 auto;
}

/*********************************************************************
 * Navegação 
 ********************************************************************/

/* Container da lista de links */
.navigation ul {
    list-style: none; /* Remove os marcadores da lista */
    padding: 0;
    margin: 0;
}

.navigation a {
    text-decoration: none;
    color: inherit;
}

/* Configuração dos Cartões */

.card {
    display: flex;
    overflow: hidden; /* Garante que a imagem respeite as bordas arredondadas */
    width: 100%;
    margin-bottom: 15px;
    height: var(--card-height);
    border-radius: 7px;
    border: solid 1.2px var(--color-surface-emphasis);
}

/* Área da Imagem */
.card-image, .card-icon {
    flex: 1; /* Ocupa uma parte proporcional do espaço */
    height: var(--card-height);
    flex-shrink: 0;
}

.card-image img {
    flex: 1;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Faz a imagem cobrir o espaço sem distorcer */
    /* display: block; */

    mask-image: linear-gradient(
        to left,
        transparent,
        black var(--fade-size, 5rem)
    );
}

.card-icon {
    display: flex;
    justify-content: center;  /* Centraliza na horizontal */
    align-items: center;      /* Centraliza na vertical */
}

.card-icon img {
    flex: 1; /* Ocupa uma parte proporcional do espaço */
    height: 50%;
    flex-shrink: 0;
    text-align: center;
    justify-content: center;
    object-fit: contain;
    margin: 0 auto;
}

/* Área do Conteúdo */
.card-content {
    flex: 2; /* Ocupa o dobro do espaço da imagem */
    padding-left: 5px;
    padding-right: 5px;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centraliza o texto verticalmente */
}

.card-content h3 {
    /* margin: 0 0 15px 0; */ /* Remove margens que empurram o texto para fora */
    line-height: 1.5rem;
    margin: 0;
    margin-bottom: 5px;
}

.card-content p {
    /* margin: 0 0 10px 0; */ /* Remove margens que empurram o texto para fora */
    line-height: 1.5;
    margin: 0;
}

/**********/
/* Rodapé */
/**********/
footer p {    
    color: color-mix(in srgb, var(--color-text-muted) 25%, transparent);
}

footer a {
    text-decoration: none;
    color: inherit;
}

/*********************/
/* Design Responsivo */
/*********************/

/* Extra small devices (phones, 600px and down) */
@media only screen and (max-width: 600px) {
    .header img {
        width: 90vw;
    }
    .container {
        width: 90vw;
    }
} 

/* Small devices (portrait tablets and large phones, 600px and up) */
@media only screen and (min-width: 600px) {
    .container {
        width: 90vw;
    }
    .header {
        width: 60vw;
    }
}

/* Medium devices (landscape tablets, 768px and up) */
@media only screen and (min-width: 768px) {
    .container {
        max-width: 80vw;
    }
    .header {
        max-width: 40vw;
    }
}

/* Large devices (laptops/desktops, 992px and up) */
@media only screen and (min-width: 992px) {
    .header {
        max-width: 30vw;
    }
}

/* Extra large devices (large laptops and desktops, 1200px and up) */
@media only screen and (min-width: 1200px) {
    .header {
        max-width: 30vw;
    }
    /* .header img { */
    /*     width: 10%; */
    /*     display: none; */
    /* } */

    body {
        height: 100vh;
    }
}

/* Extra Extra large devices (large laptops and desktops, 2000px and up) */
@media only screen and (min-width: 2000px) {
    .container {
        margin: 0;
        position: absolute;
        top: 50%;
        left: 50%;
        -ms-transform: translate(-50%, -50%);
        transform: translate(-50%, -50%);
    }
    .header {
        max-width: 17vw;
    }
    .header img {
        width: 100%;
    }
}

/* Extra Extra Extra large devices (large laptops and desktops, 3000px and up) */
@media only screen and (min-width: 3000px) {
    .container {
        margin: 0;
        position: absolute;
        top: 50%;
        left: 50%;
        -ms-transform: translate(-50%, -50%);
        transform: translate(-50%, -50%);
    }
    .header {
        max-width: 11vw;
    }
    .header img {
        width: 100%;
    }
}

